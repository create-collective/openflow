{
  "name": "openflow",
  "productName": "OpenFlow",
  "version": "0.7.0",
  "private": true,
  "description": "OpenFlow desktop app: the Electron shell around the frozen Python backend and the built renderer.",
  "homepage": "https://github.com/create-collective/openflow",
  "desktopName": "openflow.desktop",
  "license": "Apache-2.0",
  "main": "electron/main.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "build:frontend": "npm --prefix frontend run build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs",
    "build:app": "npm run version:check && npm run build:frontend && npm run build:sidecar && npm run smoke:sidecar && electron-builder --publish never",
    "build:win": "npm run build:app -- --win nsis portable",
    "build:mac": "npm run build:app -- --mac dmg",
    "build:linux": "npm run build:app -- --linux AppImage deb",
    "start": "electron .",
    "start:dev": "cross-env OPENFLOW_DEV=1 electron ."
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.traviswye.openflow",
    "productName": "OpenFlow",
    "copyright": "Copyright 2026 OpenFlow contributors. Apache-2.0.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "backend/dist/openflow-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "create-collective",
        "repo": "openflow"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Configure the Naya Create keyboard, offline",
      "description": "Configure the Naya Create keyboard offline: key bindings, lighting, modules and macros.",
      "maintainer": "traviswye <travis.createcollective@gmail.com>",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "fpm": [
        "build/linux/70-openflow.rules=/usr/lib/udev/rules.d/70-openflow.rules"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
