{
  "name": "openflow-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "OpenFlow renderer — faithful rebuild of the NayaFlow UI on an open backend.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "node tools/check-undefined.mjs && node tools/check-styles.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run check && npm run test && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
