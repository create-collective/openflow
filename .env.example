# Copy to openflow/.env and fill in. That file is gitignored; this one is not, so never
# put a real token here.
#
# Used only by scripts/publish-beta.mjs, to hand a build to the beta testers.

# The R2 bucket the installers go into.
R2_BUCKET=openflow-beta

# The bucket's PUBLIC base URL, no trailing slash. Either its r2.dev development URL or a
# custom domain. This plus an unguessable prefix is what makes a link shareable but not
# discoverable.
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# OPTIONAL. Leave blank if you have run `wrangler login`: that OAuth session is what the
# script uses, and nothing long-lived is stored on disk.
#
# Only worth setting for an unattended run, where no browser is available to log in. If you
# do set one, create it under R2 > Manage R2 API Tokens with Object Read & Write and "Apply
# to specific buckets only" set to the bucket above. Scoped that way it cannot reach DNS,
# Workers, other zones or any other bucket in the account.
CLOUDFLARE_API_TOKEN=
