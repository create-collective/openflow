# Copy to openflow/.env and fill in. That file is gitignored; this one is not, so never
# put a real token here.
#
# Used only by scripts/publish-beta.mjs, to hand a build to the beta testers.

# The R2 bucket the installers go into.
R2_BUCKET=openflow-beta

# The bucket's PUBLIC base URL, no trailing slash. Either its r2.dev development URL or a
# custom domain. This plus an unguessable prefix is what makes a link shareable but not
# discoverable.
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# An R2 API token, created under R2 > Manage R2 API Tokens, with Object Read & Write and
# "Apply to specific buckets only" set to the bucket above. Scoped that way it cannot see
# DNS, Workers, other zones or any other bucket in the account.
CLOUDFLARE_API_TOKEN=
